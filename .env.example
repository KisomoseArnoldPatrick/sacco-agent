# Copy this file to .env and fill in real values locally.
# NEVER commit the real .env file or your real API key.

# Google AI Studio API key (free tier — no card required for Flash/Flash-Lite)
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# Which Gemini model to use.
# Free tier: gemini-2.5-flash or gemini-2.5-flash-lite
GEMINI_MODEL=gemini-2.5-flash

# Vector store / retrieval config (used from Week 3 onward, not needed yet)
VECTOR_STORE_PATH=./knowledge/index

# Application environment
APP_ENV=development
