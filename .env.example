# Copy this file to .env and fill in real values locally.
# NEVER commit the real .env file or your real API key.

# Google AI Studio API key (free tier — no card required)
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# Which Gemini model to use.
# Selected in Model Selection Note: gemini-3.8-flash (free tier, no announced
# shutdown date, built for agentic/multi-step workflows).
GEMINI_MODEL=gemini-3.8-flash

# Vector store / retrieval config (used from Week 3 onward, not needed yet)
VECTOR_STORE_PATH=./knowledge/index

# Application environment
APP_ENV=development
